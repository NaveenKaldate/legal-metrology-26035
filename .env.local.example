# Copy to .env.local and fill in. .env.local is gitignored - never commit it.

# Supabase project URL and publishable (anon) key.
# Supabase dashboard -> Project Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<your publishable key>

# Public base URL of this application, used to build the verification URL that
# the report QR code encodes. Without it the QR falls back to a relative path,
# which will not scan from a phone - so set it for any demo or deployment.
# No trailing slash.
#   local demo : http://localhost:3000
#   deployed   : https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTE: only NEXT_PUBLIC_* values are used by this application, and all of them
# are safe to expose to the browser. A Supabase service-role key is NOT used
# anywhere and must never be added here - it bypasses RLS entirely.
